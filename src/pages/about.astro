---
import Layout from "../layouts/Layout.astro";
import { site, social } from "../config";

// ── Edit everything below to tell your own story. ───────────────────────────
// The little "fact" cards are just example fields — rename them, add more, or
// remove the whole block if you prefer plain prose.
const facts = [
    { label: "ROL", line: "Fotoğrafçı", muted: "Ankara, Türkiye" },
    { label: "EKİPMAN", line: "M50 Mark II", muted: "" },
//    { label: "BAŞLANGIÇ", line: "2024", muted: "" },
];
---

<Layout
    title="About"
    description={`${site.name} hakkında`}
>
    <article class="page prose">
        <h1 class="page__title">Hakkımda</h1>

        <p class="lede">
            Ben {site.name}, fotoğrafçı ve blog yazarı. Ankara, Türkiye'de yaşıyorum ve fotoğraf çekmeyi seviyorum.
        </p>

        <p>
            Sokak çalışmalarımda şehrin gündelik ritmini,
            insanların arasındaki küçük anları ve bunların ardındaki hikâyeyi kadraja alıyorum.
            Etkinlik fotoğrafçılığında ise doğru anı yakalamaya, bir organizasyonun atmosferini ve insanlarını
            kareye taşımaya odaklanıyorum.
        </p>

        <p>

        </p>

        <p>

        </p>

        <div class="facts">
            {
                facts.map((f) => (
                    <section class="fact">
                        <h2 class="fact__label">{f.label}</h2>
                        <p class="fact__line">{f.line}</p>
                        <p class="fact__muted">{f.muted}</p>
                    </section>
                ))
            }
        </div>

        <!-- <p>
            <a
                class="text-link"
                href={social.github}
                target="_blank"
                rel="noopener noreferrer"
            >
                Find me elsewhere →
            </a>
        </p> -->
    </article>
</Layout>
